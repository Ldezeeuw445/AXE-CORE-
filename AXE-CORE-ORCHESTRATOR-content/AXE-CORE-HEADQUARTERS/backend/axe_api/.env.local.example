# Copy to .env.local (gitignored) and fill in. For run-local.sh only —
# the VPS gets its own .env from deploy.sh, this file never goes there.

# Same bearer token the frontend proxy attaches. It is already in the
# frontend .env as AXE_CORE_API_KEY; reuse that value so both ends match.
AXE_API_KEY=

# In the frontend .env as VITE_SUPABASE_URL.
SUPABASE_URL=

# NOT in the frontend .env, and it must not be: VITE_-prefixed vars are bundled
# into the public JS, and this key bypasses row-level security. Take it from
# the Supabase dashboard (Project Settings -> API -> service_role).
SUPABASE_SERVICE_ROLE=

# Branch C: which repositories Claude Code may touch on THIS machine.
# name=/absolute/path, comma-separated. Anything not listed is refused, and a
# checkout sitting on main or master is refused too — so point this at a repo
# and check out a working branch before you use it.
CLAUDE_CODE_REPOS=axe-core=/Users/luka/AXE-CORE-

# Optional. Defaults to 900 seconds; a real code session can take a while.
# CLAUDE_TIMEOUT=900

# Deliberately absent: ANTHROPIC_API_KEY. Authentication is `claude auth login` on
# this machine. claude_runner strips the key from the subprocess environment
# even if something else sets it, because the CLI would prefer it over your
# subscription and nothing in the output would say which one paid.
