# NAAM DOET ERTOE: de draaiende unit heet axe-core-api.service, met streepjes.
#
# Dit bestand heette ooit axe_api.service, waardoor "systemctl restart axe_api"
# — het voor de hand liggende commando, en wat deze repo suggereerde — op
# 2026-08-19 "Unit not found" gaf terwijl de service prima draaide onder zijn
# echte naam. Een deploy die de code aanpast en daarna niets herstart is erger
# dan geen deploy: het bestand zegt iets anders dan de box doet.
#
# Geheimen staan alleen op de host, nooit in deze repo. Zie README.md.
#
# Bewust aan loopback gebonden: de box doet TLS ervoor, en deze service houdt
# de Supabase service_role-sleutel vast — hij mag dus nooit rechtstreeks vanaf
# het internet bereikbaar zijn.

[Unit]
Description=AXE Core API
Documentation=https://github.com/Ldezeeuw445/AXE-CORE-
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/axe-core-api
EnvironmentFile=/opt/axe-core-api/.env
# Twee workers, niet twaalf. Op de box gemeten en daar aangepast: 7,7 GB wordt
# gedeeld met Ollama, de browser-agent en de task-worker, en elke uvicorn-worker
# is een eigen proces met zijn eigen Supabase-client. Twaalf stond in git maar
# draaide nergens; dit is wat er echt loopt.
ExecStart=/opt/axe-core-api/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
