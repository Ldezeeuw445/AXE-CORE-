<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AXE's stem (Kokoro, bm_george) op 127.0.0.1:8011.
     Draait vanuit ~/.axe/tts (venv + model + een kopie van app.py), niet uit
     een git-checkout: een checkout, rebase of opruimactie mag AXE's stem niet
     breken. Installeren/bijwerken: backend/axe_tts/install.sh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.axe.tts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/luka/.axe/tts/.venv/bin/python</string>
    <string>app.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/luka/.axe/tts</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/luka/Library/Logs/axe-tts.log</string>
  <key>StandardErrorPath</key><string>/Users/luka/Library/Logs/axe-tts.err.log</string>
</dict>
</plist>
