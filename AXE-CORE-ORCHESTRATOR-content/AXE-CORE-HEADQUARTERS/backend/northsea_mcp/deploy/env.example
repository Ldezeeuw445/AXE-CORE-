# /opt/northsea-mcp/.env  (root:northsea-mcp, mode 640)
# ALLEEN NAMEN HIER. Waarden komen van Luka / de vault, nooit uit git of een chat.

NORTHSEA_MCP_PUBLIC_URL=https://mcp.northseacommodity.com
NORTHSEA_MCP_STATE_DB=/opt/northsea-mcp/state/state.db
# Supabase user-id(s) die mogen inloggen op de OAuth-pagina, komma-gescheiden.
NORTHSEA_MCP_ALLOWED_USER_IDS=

# AXE Commodities (NorthSea bron van waarheid): project kbimnuepbecbyezedvih
NORTHSEA_SUPABASE_URL=https://kbimnuepbecbyezedvih.supabase.co
NORTHSEA_SUPABASE_SERVICE_ROLE=

# AXE Companion (login + core_audit_log) — dezelfde waarden als /opt/axe-core-api/.env
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# Gedeelde AXE-diensten op dezelfde box — dezelfde waarden als /opt/axe-core-api/.env
AXE_API_INTERNAL_URL=http://127.0.0.1:8001
AXE_API_KEY=
TAVILY_API_KEY=
# Tweede zoekprovider in de keten Tavily -> Zenserp -> Perplexity.
ZENSERP_API_KEY=
CREW_VENV_PY=/opt/axe-crew-venv/bin/python3

# Toegewijde NorthSea CrewAI-workforce (CrewAI Studio / AMP). Eén deployment per crew.
# Leeg laten tot de deployment geleverd is; tot dan draait depth=deep op de algemene
# AXE CORE-crew als ZICHTBARE fallback (fallback_used=true in resultaat en audit).
NORTHSEA_CREW_DISCOVERY_URL=
NORTHSEA_CREW_DISCOVERY_TOKEN=
NORTHSEA_CREW_DEAL_URL=
NORTHSEA_CREW_DEAL_TOKEN=
NORTHSEA_CREW_INTELLIGENCE_URL=
NORTHSEA_CREW_INTELLIGENCE_TOKEN=
NORTHSEA_CREW_OPERATIONS_URL=
NORTHSEA_CREW_OPERATIONS_TOKEN=
# Welke redenen fallback naar de algemene crew toestaan (komma's), of "none".
# Standaard: dedicated_backend_not_configured,dedicated_backend_unavailable,health_check_failed,capacity_exhausted,timeout
NORTHSEA_CREW_FALLBACK_ON=
