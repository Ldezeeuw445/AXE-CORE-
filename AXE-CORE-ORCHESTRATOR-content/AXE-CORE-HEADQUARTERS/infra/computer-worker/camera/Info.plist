<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  In de binary ingebakken (zie main.swift). Zonder NSCameraUsageDescription weigert macOS
  de camera aan een losse opdrachtregeltool zonder het ooit te vragen.
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>com.axe.camera</string>
  <key>CFBundleName</key>
  <string>AXE Camera</string>
  <key>NSCameraUsageDescription</key>
  <string>AXE CORE maakt op jouw verzoek een foto met deze Mac en bewaart die privé in je eigen opslag.</string>
</dict>
</plist>
