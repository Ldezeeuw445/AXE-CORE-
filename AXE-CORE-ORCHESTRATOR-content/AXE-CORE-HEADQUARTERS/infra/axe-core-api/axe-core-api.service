[Unit]
Description=AXE Core API
Documentation=https://github.com/Ldezeeuw445/AXE-CORE-
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/axe-core-api
# Secrets live only on the host, never in this repo. See README.md.
EnvironmentFile=/opt/axe-core-api/.env
# Bound to loopback on purpose: the box terminates TLS in front of this, and
# the service holds the Supabase service_role key, so it must never be
# reachable directly from the internet.
#
# workers=2 -> 4, found live 2026-08-11: with a browser tab, a packaged
# Tauri app and background loops all hitting this API at once, 33
# concurrent connections queued against 2 workers — enough that even a
# trivial local /health check had to wait behind requests genuinely
# blocked on Supabase, each bounded at 15s but still enough to starve
# everything else. 4 is a deliberately modest bump, not a max(nproc): the
# box has 6 cores but only ~1.7GB free memory at the time, and each worker
# costs roughly 300MB.
ExecStart=/opt/axe-core-api/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 4
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
