{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AXE CORE",
  "version": "1.0.0",
  "identifier": "com.axe.core.plaatapp",
  "build": {
    "beforeDevCommand": "PORT=5012 npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5012",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "AXE CORE",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capability for AXE CORE",
          "windows": [
            "main",
            "axe-*"
          ],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:webview:default",
            "core:webview:allow-create-webview-window",
            "core:window:allow-start-dragging"
          ]
        }
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AXE CORE OS",
    "longDescription": "AXE CORE — AI Operating System with OSINT surveillance, 3D maps, and multi-agent orchestration.",
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements.plist",
      "exceptionDomain": null,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
