{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AXE Overlay",
  "version": "0.1.0",
  "identifier": "nl.axe.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AXE Overlay",
        "label": "overlay",
        "width": 168,
        "height": 44,
        "minWidth": 140,
        "minHeight": 40,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "x": null,
        "y": 0,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.axecompanion.com https://www.axeheadquarters.com http://127.0.0.1:* http://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "category": "Productivity",
    "shortDescription": "Floating AXE notch + chat",
    "longDescription": "Always-on-top AXE overlay for macOS. Talks to the AXE backend; launch at login."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
